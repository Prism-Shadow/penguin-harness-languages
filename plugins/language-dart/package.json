{
  "name": "@penguinharness/language-dart",
  "version": "0.0.2",
  "type": "module",
  "description": "Dart syntax highlighting for PenguinHarness.",
  "license": "MIT",
  "author": "Myriad-Dreamin",
  "categories": [
    "languages"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness-languages.git",
    "directory": "plugins/language-dart"
  },
  "homepage": "https://github.com/Prism-Shadow/penguin-harness-languages/tree/main/plugins/language-dart",
  "keywords": [
    "penguin-harness-plugin",
    "syntax-highlighting",
    "dart"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ifaces.json"
  ],
  "scripts": {
    "gen:ifaces": "node ${PENGUIN_HARNESS:-../../../penguin-harness}/scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json",
    "build": "tsup"
  },
  "peerDependencies": {
    "@prismshadow/penguin-core": ">=0.2.14"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": ">=0.2.14",
    "@shikijs/langs": "4.3.1",
    "tsup": "^8.3.0"
  },
  "penguin": {
    "title": "Dart Language Support",
    "title_zh": "Dart 语言支持",
    "description": "Dart syntax highlighting for PenguinHarness.",
    "description_zh": "为 PenguinHarness 提供 Dart 语法高亮：一个 TextMate 语法，装上后对话里的 Dart 代码块即着色。",
    "short_description": "Dart syntax highlighting for PenguinHarness.",
    "short_description_zh": "为 PenguinHarness 提供 Dart 语法高亮。",
    "category": "software-development",
    "preinstall": false,
    "quick_start": {
      "prompt": "In any conversation, send a fenced code block tagged `dart` (aliases: dart). Dart syntax highlighting loads on first use — no configuration is needed.",
      "prompt_zh": "在任意对话里发送以 `dart` 标注的代码块（别名：dart）。Dart 语法高亮在首次使用时加载，无需任何配置。",
      "skills": []
    }
  }
}
